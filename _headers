# Cloudflare Pages response headers (ignored by other static hosts).
# The page loads only its own files and makes no third-party requests;
# this policy makes the browser enforce that.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://kr.contracts.lasu.dev; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: interest-cohort=(), browsing-topics=()

# Data files carry supplier names, some of them individuals: shown in the explorer,
# kept out of search engines (see docs/personal-data.md).
/data/*
  X-Robots-Tag: noindex
